# Copy this file to .env and fill in your values
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/edverify
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
REDIS_URL=redis://localhost:6379
BIOMETRIC_ENCRYPTION_KEY=  # base64-encoded 32-byte AES-256 key
ENVIRONMENT=development

# Face verification thresholds
FACE_SIMILARITY_THRESHOLD=0.65
LIVENESS_CONFIDENCE_THRESHOLD=0.80
MAX_IMAGE_SIZE_MB=5

# SIS integration (optional)
SIS_API_URL=http://localhost:9000
SIS_API_KEY=

# Email (optional — used for temp password delivery)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
